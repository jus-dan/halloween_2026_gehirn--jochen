adow></value></block></value><value name=\"rgb\"><shadow type=\"neopixel_colors\"><field name=\"color\">NeoPixelColors.Red</field></shadow><block type=\"neopixel_rgb\"><value name=\"red\"><shadow type=\"math_number\"><field name=\"NUM\">180</field></shadow></value><value name=\"green\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"blue\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value></block></value><next><block type=\"neopixel_set_pixel_color\"><comment pinned=\"false\" h=\"80\" w=\"160\">Heller Kern</comment><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</field></block></value><value name=\"pixeloffset\"><block type=\"variables_get\"><field name=\"VAR\" id=\"Thk]{1n8dUG|w7p7R1%R\">p</field></block></value><value name=\"rgb\"><shadow type=\"neopixel_colors\"><field name=\"color\">NeoPixelColors.Red</field></shadow><block type=\"neopixel_rgb\"><value name=\"red\"><shadow type=\"math_number\"><field name=\"NUM\">255</field></shadow></value><value name=\"green\"><shadow type=\"math_number\"><field name=\"NUM\">20</field></shadow></value><value name=\"blue\"><shadow type=\"math_number\"><field name=\"NUM\">120</field></shadow></value></block></value><next><block type=\"neopixel_set_pixel_color\"><comment pinned=\"false\" h=\"80\" w=\"160\">Roter Lichtschein</comment><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</field></block></value><value name=\"pixeloffset\"><block type=\"math_modulo\"><value name=\"DIVIDEND\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"math_arithmetic\"><field name=\"OP\">ADD</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"Thk]{1n8dUG|w7p7R1%R\">p</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></value><value name=\"DIVISOR\"><shadow type=\"math_number\"><field name=\"NUM\">59</field></shadow></value></block></value><value name=\"rgb\"><shadow type=\"neopixel_colors\"><field name=\"color\">NeoPixelColors.Red</field></shadow><block type=\"neopixel_rgb\"><value name=\"red\"><shadow type=\"math_number\"><field name=\"NUM\">140</field></shadow></value><value name=\"green\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"blue\"><shadow type=\"math_number\"><field name=\"NUM\">25</field></shadow></value></block></value></block></next></block></next></block></next></block></next></block></statement><next><block type=\"neopixel_show\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</field></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"D-}l:s$z%*bu]td2t:2*\">position</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"math_modulo\"><value name=\"DIVIDEND\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"math_arithmetic\"><field name=\"OP\">ADD</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"D-}l:s$z%*bu]td2t:2*\">position</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></value><value name=\"DIVISOR\"><shadow type=\"math_number\"><field name=\"NUM\">59</field></shadow></value></block></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">35</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"\nlet gehirn = neopixel.create(DigitalPin.P14, 59, NeoPixelMode.RGB)\nlet herz = neopixel.create(DigitalPin.P2, 30, NeoPixelMode.RGB)\n\ngehirn.setBrightness(180)\nherz.setBrightness(180)\n\n// =======================================\n// GEHIRN: CHAOTISCHE NERVENIMPULSE\n// =======================================\n\nlet anzahlLEDs = 59\nlet impulsePosition = [5, 25, 45, 12]\nlet impulseRichtung = [1, -1, 1, -1]\nlet impulseRest = [0, 0, 0, 0]\nlet impulseTempo = [1, 2, 1, 3]\nlet impulseFarbe = [0, 1, 2, 0]\n\nlet frame = 0\nlet naechsterGeistesblitz = input.runningTime() +\n    randint(2000, 5000)\nlet geistesblitzPosition = -1\nlet geistesblitzRichtung = 1\nlet gesamtblitz = 0\n\n// =======================================\n// GROVE CHAINABLE RGB\n// Clock P1 / Data P15\n// =======================================\n\nlet clockPin = DigitalPin.P1\nlet dataPin = DigitalPin.P15\n\nlet rot = [0, 0, 0]\nlet gruen = [0, 0, 0]\nlet blau = [0, 0, 0]\n\nlet pulsPhase = [0, 0.35, 0.7]\nlet pulsSchritt = [0.025, 0.019, 0.015]\nlet maxHelligkeit = [1, 0.85, 0.95]\n\nlet aktuelleRot = [35, 150, 10]\nlet aktuelleGruen = [170, 25, 230]\nlet aktuelleBlau = [255, 255, 190]\n\nlet zielRot = [35, 150, 10]\nlet zielGruen = [170, 25, 230]\nlet zielBlau = [255, 255, 190]\n\npins.digitalWritePin(clockPin, 0)\npins.digitalWritePin(dataPin, 0)\n\n// =======================================\n// GROVE P9813 PROTOKOLL\n// =======================================\n\nfunction sendeBit(bit: number) {\n    pins.digitalWritePin(clockPin, 0)\n    pins.digitalWritePin(dataPin, bit)\n    pins.digitalWritePin(clockPin, 1)\n}\n\nfunction sendeByte(wert: number) {\n    for (let b = 7; b >= 0; b--) {\n        sendeBit((wert >> b) & 1)\n    }\n}\n\nfunction sendeFarbe(r: number, g: number, b: number) {\n    let prefix = 0xC0\n    prefix |= ((~b >> 6) & 3) << 4\n    prefix |= ((~g >> 6) & 3) << 2\n    prefix |= ((~r >> 6) & 3)\n\n    sendeByte(prefix)\n    sendeByte(b)\n    sendeByte(g)\n    sendeByte(r)\n}\n\nfunction zeigeGeister() {\n    for (let i = 0; i < 4; i++) {\n        sendeByte(0)\n    }\n\n    for (let i = 0; i < 3; i++) {\n        sendeFarbe(rot[i], gruen[i], blau[i])\n    }\n\n    for (let i = 0; i < 4; i++) {\n        sendeByte(0)\n    }\n}\n\n// =======================================\n// ZUFÄLLIGE GEISTERFARBEN\n// =======================================\n\nfunction neueGeisterFarbe(i: number) {\n    let farbe = randint(0, 6)\n\n    if (farbe == 0) {\n        zielRot[i] = 35\n        zielGruen[i] = 170\n        zielBlau[i] = 255\n    } else if (farbe == 1) {\n        zielRot[i] = 150\n        zielGruen[i] = 25\n        zielBlau[i] = 255\n    } else if (farbe == 2) {\n        zielRot[i] = 10\n        zielGruen[i] = 230\n        zielBlau[i] = 190\n    } else if (farbe == 3) {\n        zielRot[i] = 220\n        zielGruen[i] = 35\n        zielBlau[i] = 190\n    } else if (farbe == 4) {\n        zielRot[i] = 170\n        zielGruen[i] = 215\n        zielBlau[i] = 255\n    } else if (farbe == 5) {\n        zielRot[i] = 25\n        zielGruen[i] = 255\n        zielBlau[i] = 35\n    } else {\n        zielRot[i] = 15\n        zielGruen[i] = 200\n        zielBlau[i] = 90\n    }\n}\n\n// =======================================\n// GEHIRN: NEUEN IMPULS STARTEN\n// =======================================\n\nfunction neuerImpuls(i: number) {\n    impulsePosition[i] = randint(0, 58)\n\n    if (randint(0, 1) == 0) {\n        impulseRichtung[i] = -1\n    } else {\n        impulseRichtung[i] = 1\n    }\n\n    // Kurze oder längere Teilstrecken\n    impulseRest[i] = randint(5, 22)\n\n    // Unterschiedliche Geschwindigkeiten\n    impulseTempo[i] = randint(1, 3)\n\n    // 0 = Pink, 1 = Violett, 2 = Eisblau\n    impulseFarbe[i] = randint(0, 2)\n}\n\n// =======================================\n// GEHIRN: CHAOTISCHES NEURONENFEUER\n// P14 / 59 LEDs\n// =======================================\n\nbasic.forever(function () {\n    frame += 1\n\n    // Sehr dunkler Hintergrund\n    gehirn.showColor(neopixel.rgb(2, 0, 3))\n\n    // Vier unabhängige Nervenimpulse\n    for (let i = 0; i < 4; i++) {\n\n        if (impulseRest[i] <= 0) {\n            // Zufällig neue Aktivität starten\n            if (randint(0, 8) == 0) {\n                neuerImpuls(i)\n            }\n        } else {\n\n            // Bewegung unterschiedlich schnell\n            if (frame % impulseTempo[i] == 0) {\n                impulsePosition[i] += impulseRichtung[i]\n                impulseRest[i] -= 1\n            }\n\n            let p = impulsePosition[i]\n\n            if (p >= 0 && p < 59) {\n\n                // Pinker Nervenimpuls\n                if (impulseFarbe[i] == 0) {\n                    gehirn.setPixelColor(\n                        p, neopixel.rgb(255, 15, 125)\n                    )\n                }\n\n                // Violetter Nervenimpuls\n                if (impulseFarbe[i] == 1) {\n                    gehirn.setPixelColor(\n                        p, neopixel.rgb(130, 0, 255)\n                    )\n                }\n\n                // Eisblauer Nervenimpuls\n                if (impulseFarbe[i] == 2) {\n                    gehirn.setPixelColor(\n                        p, neopixel.rgb(70, 180, 255)\n                    )\n                }\n\n                // Kurzer Schweif entgegen der Laufrichtung\n                let schweif = p - impulseRichtung[i]\n                if (schweif >= 0 && schweif < 59) {\n                    gehirn.setPixelColor(\n                        schweif, neopixel.rgb(45, 0, 75)\n                    )\n                }\n            }\n\n            // Am Ende des Streifens stoppen\n            if (p < 0 || p >= 59) {\n                impulseRest[i] = 0\n            }\n\n            // Seltene Richtungsumkehr\n            if (randint(0, 35) == 0) {\n                impulseRichtung[i] *= -1\n            }\n        }\n    }\n\n    // ===================================\n    // GEISTESBLITZ: ZUFÄLLIG\n    // ===================================\n\n    if (geistesblitzPosition < 0 &&\n        gesamtblitz == 0 &&\n        input.runningTime() >= naechsterGeistesblitz) {\n\n        // Zufällige Richtung\n        if (randint(0, 1) == 0) {\n            geistesblitzPosition = 0\n            geistesblitzRichtung = 1\n        } else {\n            geistesblitzPosition = 58\n            geistesblitzRichtung = -1\n        }\n    }\n\n    if (geistesblitzPosition >= 0 &&\n        geistesblitzPosition < 59) {\n\n        // Heller Blitz mit blauem Schweif\n        for (let k = 0; k < 7; k++) {\n            let p = geistesblitzPosition -\n                k * geistesblitzRichtung\n\n            if (p >= 0 && p < 59) {\n                if (k == 0) {\n                    gehirn.setPixelColor(\n                        p, neopixel.rgb(255, 255, 255)\n                    )\n                } else if (k < 3) {\n                    gehirn.setPixelColor(\n                        p, neopixel.rgb(100, 210, 255)\n                    )\n                } else {\n                    gehirn.setPixelColor(\n                        p, neopixel.rgb(15, 40, 160)\n                    )\n                }\n            }\n        }\n\n        geistesblitzPosition +=\n            geistesblitzRichtung * 5\n\n        if (geistesblitzPosition < 0 ||\n            geistesblitzPosition >= 59) {\n\n            geistesblitzPosition = -1\n            gesamtblitz = 2\n        }\n    }\n\n    // Kurzer Blitz durch den ganzen Kopf\n    if (gesamtblitz > 0) {\n        if (gesamtblitz == 2) {\n            gehirn.showColor(neopixel.rgb(170, 210, 255))\n        } else {\n            gehirn.showColor(neopixel.rgb(25, 35, 80))\n        }\n\n        gesamtblitz -= 1\n\n        if (gesamtblitz == 0) {\n            naechsterGeistesblitz =\n                input.runningTime() + randint(2000, 5000)\n        }\n    }\n\n    gehirn.show()\n    basic.pause(35)\n})\n\n// =======================================\n// HERZ: ROTER DOPPEL-HERZSCHLAG\n// P2 / 30 LEDs\n// =======================================\n\nbasic.forever(function () {\n    herz.showColor(neopixel.rgb(20, 0, 0))\n    basic.pause(180)\n\n    for (let i = 20; i <= 220; i += 25) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(15)\n    }\n\n    for (let i = 220; i >= 40; i -= 30) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(15)\n    }\n\n    for (let i = 40; i <= 255; i += 40) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(12)\n    }\n\n    for (let i = 255; i >= 25; i -= 15) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(20)\n    }\n\n    herz.showColor(neopixel.rgb(20, 0, 0))\n    basic.pause(350)\n})\n\n// =======================================\n// GESPENSTER: UNREGELMÄSSIGES GLIMMEN\n// P1 Clock / P15 Data\n// =======================================\n\nbasic.forever(function () {\n    for (let i = 0; i < 3; i++) {\n\n        pulsPhase[i] += pulsSchritt[i]\n\n        if (pulsPhase[i] >= 1) {\n            pulsPhase[i] -= 1\n            pulsSchritt[i] = 1 / randint(33, 67)\n            maxHelligkeit[i] = randint(75, 100) / 100\n            neueGeisterFarbe(i)\n        }\n\n        let puls = (1 - Math.cos(\n            pulsPhase[i] * 2 * Math.PI\n        )) / 2\n\n        let hell = 0.02 + puls *\n            (maxHelligkeit[i] - 0.02)\n\n        aktuelleRot[i] +=\n            (zielRot[i] - aktuelleRot[i]) * 0.10\n\n        aktuelleGruen[i] +=\n            (zielGruen[i] - aktuelleGruen[i]) * 0.10\n\n        aktuelleBlau[i] +=\n            (zielBlau[i] - aktuelleBlau[i]) * 0.10\n\n        rot[i] = Math.round(aktuelleRot[i] * hell)\n        gruen[i] = Math.round(aktuelleGruen[i] * hell)\n        blau[i] = Math.round(aktuelleBlau[i] * hell)\n    }\n\n    zeigeGeister()\n    basic.pause(30)\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"Gehirn & Jochen\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"Grove\": \"github:seeed-studio/pxt-grove#v0.7.5\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1793525295470}