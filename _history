reen\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"blue\"><shadow type=\"math_number\"><field name=\"NUM\">25</field></shadow></value></block></value></block></next></block></next></block></next></block></next></block></statement><next><block type=\"neopixel_show\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</field></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"D-}l:s$z%*bu]td2t:2*\">position</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"math_modulo\"><value name=\"DIVIDEND\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"math_arithmetic\"><field name=\"OP\">ADD</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"D-}l:s$z%*bu]td2t:2*\">position</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></value><value name=\"DIVISOR\"><shadow type=\"math_number\"><field name=\"NUM\">59</field></shadow></value></block></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">35</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"\nlet gehirn = neopixel.create(DigitalPin.P14, 59, NeoPixelMode.RGB)\nlet herz = neopixel.create(DigitalPin.P2, 30, NeoPixelMode.RGB)\n\nlet position = 0\nlet zeit = 0\n\ngehirn.setBrightness(180)\nherz.setBrightness(180)\n\n// =======================================\n// GROVE CHAINABLE RGB LEDS\n// Clock P1 / Data P15\n// =======================================\n\nlet clockPin = DigitalPin.P1\nlet dataPin = DigitalPin.P15\n\nlet rot = [0, 0, 0]\nlet gruen = [0, 0, 0]\nlet blau = [0, 0, 0]\n\nlet phase = [0, 2.1, 4.3]\nlet geschwindigkeit = [0.24, 0.33, 0.42]\n\npins.digitalWritePin(clockPin, 0)\npins.digitalWritePin(dataPin, 0)\n\n// =======================================\n// GROVE P9813 PROTOKOLL\n// =======================================\n\nfunction sendeBit(bit: number) {\n    pins.digitalWritePin(clockPin, 0)\n    pins.digitalWritePin(dataPin, bit)\n    pins.digitalWritePin(clockPin, 1)\n}\n\nfunction sendeByte(wert: number) {\n    for (let b = 7; b >= 0; b--) {\n        sendeBit((wert >> b) & 1)\n    }\n}\n\nfunction sendeFarbe(r: number, g: number, b: number) {\n    let prefix = 0xC0\n    prefix |= ((~b >> 6) & 3) << 4\n    prefix |= ((~g >> 6) & 3) << 2\n    prefix |= ((~r >> 6) & 3)\n\n    sendeByte(prefix)\n    sendeByte(b)\n    sendeByte(g)\n    sendeByte(r)\n}\n\nfunction zeigeGeister() {\n    // Startframe\n    for (let i = 0; i < 4; i++) {\n        sendeByte(0)\n    }\n\n    // Drei unabhängige Gespenster\n    for (let i = 0; i < 3; i++) {\n        sendeFarbe(rot[i], gruen[i], blau[i])\n    }\n\n    // Endframe\n    for (let i = 0; i < 4; i++) {\n        sendeByte(0)\n    }\n}\n\n// =======================================\n// GEHIRN: WANDERNDE NERVENIMPULSE\n// P14 - 59 NeoPixel\n// =======================================\n\nbasic.forever(function () {\n    gehirn.showColor(neopixel.rgb(12, 0, 8))\n\n    for (let j = 0; j < 3; j++) {\n        let p = (position + j * 19) % 59\n\n        // Violetter Schweif\n        gehirn.setPixelColor(\n            (p + 57) % 59,\n            neopixel.rgb(50, 0, 100)\n        )\n\n        // Pinker Schweif\n        gehirn.setPixelColor(\n            (p + 58) % 59,\n            neopixel.rgb(180, 0, 100)\n        )\n\n        // Heller Kern\n        gehirn.setPixelColor(\n            p,\n            neopixel.rgb(255, 20, 120)\n        )\n\n        // Roter Lichtschein\n        gehirn.setPixelColor(\n            (p + 1) % 59,\n            neopixel.rgb(140, 0, 25)\n        )\n    }\n\n    gehirn.show()\n    position = (position + 1) % 59\n    basic.pause(35)\n})\n\n// =======================================\n// HERZ: ROTER DOPPEL-HERZSCHLAG\n// P2 - 30 NeoPixel\n// =======================================\n\nbasic.forever(function () {\n\n    // Schwaches Grundglühen\n    herz.showColor(neopixel.rgb(20, 0, 0))\n    basic.pause(180)\n\n    // Erster Herzschlag\n    for (let i = 20; i <= 220; i += 25) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(15)\n    }\n\n    for (let i = 220; i >= 40; i -= 30) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(15)\n    }\n\n    // Zweiter, kräftiger Herzschlag\n    for (let i = 40; i <= 255; i += 40) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(12)\n    }\n\n    for (let i = 255; i >= 25; i -= 15) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(20)\n    }\n\n    // Pause bis zum nächsten Herzschlag\n    herz.showColor(neopixel.rgb(20, 0, 0))\n    basic.pause(350)\n})\n\n// =======================================\n// GESPENSTER: MAGISCHES SPUK-GLIMMEN\n// P1 Clock / P15 Data\n// 3 Grove Chainable RGB LEDs\n// =======================================\n\nbasic.forever(function () {\n\n    // Etwa 30 % langsamer als Testmodus 3\n    zeit += 0.084\n\n    for (let i = 0; i < 3; i++) {\n\n        // Unabhängiges Pulsieren\n        let puls = (Math.sin(\n            zeit * (2.5 + i * 0.65) + phase[i]\n        ) + 1) / 2\n\n        // Helligkeit fällt fast auf null\n        let hell = puls * puls * puls\n\n        // Langsame, unabhängige Farbwechsel\n        let farbZeit = zeit * geschwindigkeit[i] * 3\n            + phase[i]\n\n        let mix = (Math.sin(farbZeit) + 1) / 2\n        let mix2 = (Math.sin(\n            farbZeit * 0.7 + 2\n        ) + 1) / 2\n\n        // Eisblau, Türkis, Violett und Lila\n        let r = 20 + 200 * mix\n        let g = 30 + 190 * (1 - mix) * mix2\n        let b = 170 + 85 * (1 - mix2)\n\n        rot[i] = Math.round(r * hell)\n        gruen[i] = Math.round(g * hell)\n        blau[i] = Math.round(b * hell)\n    }\n\n    zeigeGeister()\n    basic.pause(30)\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"Gehirn & Jochen\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"Grove\": \"github:seeed-studio/pxt-grove#v0.7.5\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1793525284475,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</variable><variable id=\"+7mVi[-No[A?#E=JaOJi\">j</variable><variable id=\"Thk]{1n8dUG|w7p7R1%R\">p</variable><variable id=\"D-}l:s$z%*bu]td2t:2*\">position</variable><variable id=\"0|B,V{5I~^lkwT_w49m^\">herz</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"neopixel_create\"><field name=\"pin\">DigitalPin.P14</field><field name=\"mode\">NeoPixelMode.RGB</field><value name=\"numleds\"><shadow type=\"math_number\"><field name=\"NUM\">59</field></shadow></value></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"0|B,V{5I~^lkwT_w49m^\">herz</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"neopixel_create\"><field name=\"pin\">DigitalPin.P2</field><field name=\"mode\">NeoPixelMode.RGB</field><value name=\"numleds\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value></block></value><next><block type=\"neopixel_set_brightness\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">