  for (let i = 25; i <= 220; i += 25) {\n            gehirnLicht(i)\n            basic.pause(15)\n        }\n        for (let i = 220; i >= 40; i -= 30) {\n            gehirnLicht(i)\n            basic.pause(15)\n        }\n"]]},{"start1":930,"length1":130,"diffs":[[1,"        // Zweiter schneller Herzschlag\n        for (let i = 40; i <= 255; i += 40) {\n            gehirnLicht(i)\n            basic.pause(12)\n        }\n        for (let i = 255; i >= 25; i -= 15) {\n            gehirnLicht(i)\n            basic.pause(20)\n        }\n        basic.pause(350)\n    }\n"]]},{"start1":1224,"length1":127,"diffs":[[1,"    // MODUS 2: Wandernde Nervenimpulse\n    if (modus == 1) {\n        strip2.showColor(neopixel.rgb(2, 0, 15))\n"]]},{"start1":1336,"length1":140,"diffs":[[1,"        // Drei Impulse mit Abstand\n        for (let j = 0; j < 3; j++) {\n            let p = (position + j * 19) % 59\n            strip2.setPixelColor(p, neopixel.rgb(140, 200, 255))\n            strip2.setPixelColor((p + 58) % 59, neopixel.rgb(15, 40, 180))\n            strip2.setPixelColor((p + 1) % 59, neopixel.rgb(30, 0, 100))\n        }\n\n        strip2.show()\n        position = (position + 1) % 59\n        basic.pause(35)\n"]]},{"start1":1771,"length1":73,"diffs":[[1,"    // MODUS 3: Chaotische Gedanken\n    if (modus == 2) {\n        strip2.showColor(neopixel.rgb(12, 0, 8))\n\n        // Zufällige aktive Neuronen\n        for (let k = 0; k < 12; k++) {\n            let p = randint(0, 58)\n            let farbe = randint(0, 2)\n\n            if (farbe == 0) {\n                strip2.setPixelColor(p, neopixel.rgb(255, 0, 25))\n            } else if (farbe == 1) {\n                strip2.setPixelColor(p, neopixel.rgb(120, 0, 255))\n            } else {\n                strip2.setPixelColor(p, neopixel.rgb(255, 20, 120))\n            }\n        }\n\n        strip2.show()\n        basic.pause(randint(30, 110))\n    }\n\n    // MODUS 4: Zombie-Gehirn\n    if (modus == 3) {\n        strip2.showColor(neopixel.rgb(0, 18, 2))\n\n        // Giftgrüne elektrische Impulse\n        for (let k = 0; k < 8; k++) {\n            let p = randint(0, 58)\n            strip2.setPixelColor(p, neopixel.rgb(20, 255, 0))\n        }\n\n        strip2.show()\n        basic.pause(65)\n\n        // Gelegentliche Schock-Entladung\n        if (randint(0, 18) == 0) {\n            strip2.showColor(neopixel.rgb(180, 255, 180))\n            basic.pause(35)\n            strip2.showColor(neopixel.rgb(0, 5, 0))\n            basic.pause(60)\n        }\n    }\n"]]}]}]},{"timestamp":1793447743081,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":1,"length1":131,"diffs":[[1,"let strip2 = neopixel.create(DigitalPin.P14, 59, NeoPixelMode.RGB)\n"]]},{"start1":86,"length1":50,"diffs":[[1,"strip2.setBrightness(180)\n"]]},{"start1":113,"length1":35,"diffs":[[1,""]]},{"start1":141,"length1":45,"diffs":[[1,"    // Dunkelrotes Grundglühen\n    strip2.showColor(neopixel.rgb(12, 0, 8))\n"]]},{"start1":218,"length1":0,"diffs":[[1,"    // Drei wandernde Nervenimpulse\n"]]},{"start1":330,"length1":59,"diffs":[[1,"        // Schweif: Violett\n        strip2.setPixelColor(\n"]]},{"start1":463,"length1":56,"diffs":[[1,"        // Schweif: Pink\n        strip2.setPixelColor(\n"]]},{"start1":594,"length1":53,"diffs":[[1,"        // Heller Kern: Rot-Pink\n        strip2.setPixelColor(\n"]]},{"start1":722,"length1":59,"diffs":[[1,"        // Vorderer Lichtschein: Rot\n        strip2.setPixelColor(\n"]]},{"start1":869,"length1":18,"diffs":[[1,"    strip2.show()\n"]]},{"start1":945,"length1":809,"diffs":[[1,""]]}]}]},{"timestamp":1793448214154,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":12494,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"j=dRD.YC(2{h%L3;S/i-\">strip</variable><variable id=\"a]API$Tq%BD}E`sO%1bw\">strip2</variable></variables><block type=\"px