rz.setBrightness(180)\n\n// GEHIRN: Wandernde Nervenimpulse\nbasic.forever(function () {\n    gehirn.showColor(neopixel.rgb(12, 0, 8))\n\n    for (let j = 0; j < 3; j++) {\n        let p = (position + j * 19) % 59\n\n        // Violetter Schweif\n        gehirn.setPixelColor(\n            (p + 57) % 59,\n            neopixel.rgb(50, 0, 100)\n        )\n\n        // Pinker Schweif\n        gehirn.setPixelColor(\n            (p + 58) % 59,\n            neopixel.rgb(180, 0, 100)\n        )\n\n        // Heller Kern\n        gehirn.setPixelColor(\n            p,\n            neopixel.rgb(255, 20, 120)\n        )\n\n        // Roter Lichtschein\n        gehirn.setPixelColor(\n            (p + 1) % 59,\n            neopixel.rgb(140, 0, 25)\n        )\n    }\n\n    gehirn.show()\n    position = (position + 1) % 59\n    basic.pause(35)\n})\n\n// HERZ: Roter Doppel-Herzschlag\nbasic.forever(function () {\n\n    // Schwaches rotes Grundglühen\n    herz.showColor(neopixel.rgb(20, 0, 0))\n    basic.pause(180)\n\n    // Erster Herzschlag\n    for (let i = 20; i <= 220; i += 25) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(15)\n    }\n\n    for (let i = 220; i >= 40; i -= 30) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(15)\n    }\n\n    // Zweiter, kräftiger Herzschlag\n    for (let i = 40; i <= 255; i += 40) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(12)\n    }\n\n    for (let i = 255; i >= 25; i -= 15) {\n        herz.showColor(neopixel.rgb(i, 0, 0))\n        basic.pause(20)\n    }\n\n    // Pause bis zum nächsten Herzschlag\n    herz.showColor(neopixel.rgb(20, 0, 0))\n    basic.pause(350)\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"Gehirn & Jochen\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"Grove\": \"github:seeed-studio/pxt-grove#v0.7.5\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1793451795212,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</variable><variable id=\"+7mVi[-No[A?#E=JaOJi\">j</variable><variable id=\"Thk]{1n8dUG|w7p7R1%R\">p</variable><variable id=\"D-}l:s$z%*bu]td2t:2*\">position</variable><variable id=\"0|B,V{5I~^lkwT_w49m^\">herz</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"neopixel_create\"><field name=\"pin\">DigitalPin.P14</field><field name=\"mode\">NeoPixelMode.RGB</field><value name=\"numleds\"><shadow type=\"math_number\"><field name=\"NUM\">59</field></shadow></value></block></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"0|B,V{5I~^lkwT_w49m^\">herz</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"neopixel_create\"><field name=\"pin\">DigitalPin.P2</field><field name=\"mode\">NeoPixelMode.RGB</field><value name=\"numleds\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value></block></value><next><block type=\"neopixel_set_brightness\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"_=^Pxnhw?:T}#ZI%o+fu\">gehirn</field></block></value><value name=\"brightness\"><shadow type=\"math_number\"><field name=\"NUM\">180</field></shadow></value><next><block type=\"neopixel_set_brightness\"><value name=\"strip\"><block type=\"variables_get\"><field name=\"VAR\" id=\"0|B,V{5I~^lkwT_w49m^\">herz</field></block></value><value name=\"brightness\"><shadow type=\"math_number\"><field name=\"NUM\">180</field></shadow></value></block><